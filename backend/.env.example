# Copy this file to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key used for the AI Screening agent
ANTHROPIC_API_KEY=

# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://ican:ican@localhost:5432/ican

# MongoDB migration connection. Does NOT yet switch the existing SQL services.
# Put credentials only in the ignored .env or hosting environment variables.
MONGODB_URL=
MONGODB_DATABASE=ican

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Official Data.gov.ua / State Employment Service market snapshots.
# The service checks metadata daily and downloads the large XML only when new.
MARKET_DATA_AUTO_REFRESH=true
MARKET_DATA_REFRESH_HOURS=24

# Admin dashboard auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
