# Скопіюйте цей файл як .env і заповніть власні значення.
# Файл .env не можна додавати до Git.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE=ican
JWT_SECRET=<generate-a-long-random-secret>
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://ican-frontend-mnu.vercel.app

# Приватне зберігання CV, які прикріплюють працівники. Dropbox App Folder.
DROPBOX_ROOT=/ican-cv
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Необов'язково для завантаження файлу; потрібно для аналізу CV або анкети.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
CV_ANALYSIS_ENABLED=false
CV_ANALYSIS_DAILY_LIMIT=5
