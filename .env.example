# Copy this file to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key used for the AI Screening agent
ANTHROPIC_API_KEY=

# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://ican:ican@localhost:5432/ican

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Admin dashboard auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Which Telegram bot flow the worker process registers -- "legacy" (default)
# keeps today's ICAN 1.1 screening bot; "v1" registers the Stage 1 Hybrid
# Assessment flow, the only one wired to PotentialProfile/DirectionRun/the
# MNP consultant dashboard. Set to v1 on the bot ("worker") service before
# any Stage 1-4 pilot smoke test -- it silently stays "legacy" otherwise.
BOT_FLOW=legacy
